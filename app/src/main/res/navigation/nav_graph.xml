<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation_graph"
    app:startDestination="@id/libraryFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.practicum.playlistmaker.search.ui.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/fragment_search" >
    </fragment>

    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.practicum.playlistmaker.media.ui.playlists.MediaFragment"
        android:label="MediaFragment"
        tools:layout="@layout/fragment_media">
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.practicum.playlistmaker.settings.ui.SettingsFragment"
        android:label="SettingsFragment"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.practicum.playlistmaker.media.ui.favorites.FavoritesFragment"
        android:label="FavoritesFragment"
        tools:layout="@layout/fragment_favorites">
    </fragment>

    <fragment
        android:id="@+id/newPlaylistFragment"
        android:name="com.practicum.playlistmaker.new_playlist.ui.fragment.NewPlaylistFragment"
        android:label="NewPlaylist"
        tools:layout="@layout/fragment_new_playlist" />
    <action
        android:id="@+id/action_to_new_playlist"
        app:destination="@id/newPlaylistFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right" />

    <fragment
        android:id="@+id/playlistsFragment"
        android:name="com.practicum.playlistmaker.media.ui.playlists.PlaylistsFragment"
        android:label="PlaylistsFragment"
        tools:layout="@layout/fragment_playlists">
    </fragment>


    <fragment
        android:id="@+id/playerFragment"
        android:name="com.practicum.playlistmaker.player.ui.PlayerFragment"
        android:label="PlayerFragment"
        tools:layout="@layout/fragment_player"/>

    <action
        android:id="@+id/action_to_Player"
        app:destination="@id/playerFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right" />
    <dialog
        android:id="@+id/playlists_bottom_sheet"
        android:name="com.practicum.playlistmaker.media.ui.bottom_sheet.PlaylistsBottomSheet"
        android:label="BottomSheetPlayer"
        tools:layout="@layout/bottom_sheet_playlists" >
    </dialog>


    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.practicum.playlistmaker.media.ui.playlist.PlaylistFragment"
        android:label="PlaylistFragment"
        tools:layout="@layout/fragment_playlist" />
    <action
        android:id="@+id/action_to_PlaylistFragment"
        app:destination="@id/playlistFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right" />
</navigation>